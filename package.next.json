{
  "name": "awesome-video-prompts-next",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js 15 App Router for Awesome Video Prompts",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy": "npm run build && wrangler pages deploy .open-next/assets",
    "deploy:workers": "wrangler deploy .open-next/workers-stack",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:migrate:local": "wrangler d1 execute prompts-db --local --file=./drizzle/migrations/0000_init.sql",
    "import:md": "tsx scripts/import-md-to-d1.ts",
    "import:md:local": "tsx scripts/import-md-to-d1.ts --local --db prompts-db"
  },
  "dependencies": {
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "gray-matter": "^4.0.3",
    "next-intl": "^3.26.0"
  },
  "devDependencies": {
    "@cloudflare/next-onpages": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0",
    "opennextjs-cloudflare": "^1.0.0",
    "tsx": "^4.19.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "vitest": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@playwright/test": "^1.48.0",
    "@vitest/ui": "^2.1.0",
    "vitest-environment-miniflare": "^2.15.0"
  }
}
